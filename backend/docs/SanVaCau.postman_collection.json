{
  "info": {
    "name": "SanVaCau API",
    "description": "Postman collection for SanVaCau badminton court booking & shop backend API.\n\nBase URL: http://localhost:3000/api\n\nSetup:\n1. Run POST Login Admin to get adminToken\n2. Run POST Register Customer + POST Login Customer to get customerToken\n3. Variables are auto-saved by test scripts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "branchId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "productVariantId", "value": "1" },
    { "key": "courtId", "value": "1" },
    { "key": "bookingId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "timeSlotId", "value": "1" }
  ],
